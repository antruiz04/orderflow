# Postgres (en docker compose el host es "postgres")
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
ORDERS_DB_NAME=orders_db
INVENTORY_DB_NAME=inventory_db

# Redpanda: en Docker redpanda:9092 | desde el PC localhost:19092
KAFKA_BROKER=localhost:19092
KAFKA_BROKER_DOCKER=redpanda:9092

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1d

SMTP_HOST=mailhog
SMTP_PORT=1025
